{
  "version": 1,
  "storage": { "type": "file" },
  "server": {
    "listenAddress": "127.0.0.1:8080",
    "basePath": "",
    "dataDir": "data",
    "secureCookie": false,
    "sessionTTL": "12h",
    "tls": {
      "enabled": false,
      "certFile": "",
      "keyFile": ""
    }
  },
  "ui": {
    "workspaceTitle": "minihub",
    "loginMessage": "ユーザーIDとパスワードを入力してください。"
  },
  "auth": {
    "mode": "sso",
    "miniauth": {
      "url": "http://127.0.0.1:8090",
      "clientID": "minihub-chat",
      "clientSecret": "chat-secret-abcdef",
      "serviceToken": "minihub-sync-service-token-12345",
      "syncInterval": "10m"
    }
  },
  "features": {
    "selfPasswordChange": false,
    "networkPathMode": "copy"
  },
  "notifications": { "mentionRetentionDays": 365, "osNotificationsEnabled": true },
  "retention": { "days": 0 },
  "logging": { "level": "info" },
  "aiAccounts": []
}
